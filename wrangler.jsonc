{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker de STAGING (plano Free). Produção ainda não foi autorizada.
  "name": "j-sampaio-postos-staging",
  "main": "worker/index.ts",
  // Data que habilita o node:crypto necessário para os hashes scrypt.
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "1f28aafc622547278edf74327a9f4c3e" }
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "jsampaio-staging-files" }],
  "vars": { "TRPC_ENABLED": "true" }
}
